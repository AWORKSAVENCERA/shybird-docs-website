---
layout: null
sitemap: false
---
{%- comment -%}
  Lists every HTML page except those with `sitemap: false` in front matter (e.g. the 404 page, drafts).
  Add `last_modified_at: YYYY-MM-DD` to a page's front matter to give it a <lastmod>.
  URLs include baseurl, so the staging build lists /staging/ URLs.
{%- endcomment -%}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- assign pages = site.html_pages | where_exp: "p", "p.sitemap != false" | sort: "url" %}
{%- for page in pages %}
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}{{ page.url }}</loc>
    {%- if page.last_modified_at %}
    <lastmod>{{ page.last_modified_at | date_to_xmlschema }}</lastmod>
    {%- endif %}
  </url>
{%- endfor %}
</urlset>

#!/usr/bin/env bash
# Validates commit messages for the Shybird docs repo (see .claude/skills/git/SKILL.md).
# Enable once per clone:  git config core.hooksPath .githooks
#
# Format:  type(optional-scope): imperative summary
#   - types: content docs fix feat a11y style build ci chore refactor revert
#   - subject <= 72 characters, no trailing full stop
#   - if there is a body, it is separated from the subject by one blank line
set -euo pipefail

msg_file="$1"
# Drop comment lines and the verbose diff that `git commit -v` appends.
msg="$(sed -e '/^# ------------------------ >8 ------------------------$/,$d' -e '/^#/d' "$msg_file")"
subject="$(printf '%s\n' "$msg" | sed -n '1p')"
second="$(printf '%s\n' "$msg" | sed -n '2p')"

# Let git's own generated messages through.
case "$subject" in
  "Merge "*|"Revert \""*|"fixup! "*|"squash! "*|"amend! "*) exit 0 ;;
esac

types='content|docs|fix|feat|a11y|style|build|ci|chore|refactor|revert'
fail() {
  {
    echo "commit-msg: $1"
    echo
    echo "  Your subject: $subject"
    echo
    echo "  Expected:     type(scope): imperative summary   (<= 72 chars, no trailing '.')"
    echo "  Types:        ${types//|/, }"
    echo "  Examples:     content(trust): add data retention table"
    echo "                a11y: make scrollable tables keyboard focusable"
    echo "                ci: run WCAG 2.2 AA checks before deploy"
  } >&2
  exit 1
}

[ -n "$subject" ] || fail "empty commit message"
printf '%s' "$subject" | grep -Eq "^($types)(\([a-z0-9][a-z0-9-]*\))?!?: [^ ].*" \
  || fail "subject must start with a type, e.g. 'content: ...' or 'fix(nav): ...'"
[ "${#subject}" -le 72 ] || fail "subject is ${#subject} characters; keep it to 72 or fewer"
case "$subject" in *.) fail "subject must not end with a full stop" ;; esac
[ -z "$second" ] || fail "leave a blank line between the subject and the body"
exit 0
